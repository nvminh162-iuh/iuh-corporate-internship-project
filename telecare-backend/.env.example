# ==============================================================================
# Telecare Backend - Environment Variables Template
# All secrets and sensitive credentials MUST be provided through environment variables.
# NEVER commit real credentials or .env files into version control.
# ==============================================================================

# Core Application
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=55080
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_APP=INFO

# Database Connection (PostgreSQL)
DATASOURCE_URL=jdbc:postgresql://localhost:55432/telecare
DATASOURCE_USERNAME=telecare
DATASOURCE_PASSWORD=telecare123
JPA_DDL_AUTO=update

# Redis Cache
REDIS_HOST=localhost
REDIS_PORT=56379
REDIS_PASSWORD=telecare123

# Apache Kafka Broker
KAFKA_BOOTSTRAP_SERVERS=localhost:59092

# Keycloak Identity & Access Management (IAM)
KEYCLOAK_SERVER_URL=http://localhost:59000
KEYCLOAK_ADMIN_USERNAME=telecare
KEYCLOAK_ADMIN_PASSWORD=telecare123
KEYCLOAK_ADMIN_REALM=master
KEYCLOAK_ADMIN_CLIENT_ID=admin-cli
KEYCLOAK_CURRENT_REALM=telecare-platform
KEYCLOAK_CLIENT_ID=telecare-id

# System Admin Bootstrap (Disable in production)
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_USERNAME=telecare
BOOTSTRAP_ADMIN_EMAIL=admin@telecare.vn
BOOTSTRAP_ADMIN_PASSWORD=Telecare@123
BOOTSTRAP_ADMIN_FIRST_NAME=System
BOOTSTRAP_ADMIN_LAST_NAME=Administrator

# AWS S3 Storage
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=telecare-files
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key

# Mail Service (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@telecare.vn
SMTP_PASSWORD=your-app-password
SMTP_FROM=your-email@telecare.vn
SMTP_FROM_NAME=TeleCare

# Swagger Documentation (Disabled in production)
SWAGGER_ENABLED=true
