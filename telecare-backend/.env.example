# Core Application
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=55080
LOGGING_LEVEL_ROOT=INFO
LOGGING_LEVEL_APP=INFO

# Database Connection (PostgreSQL)
DATASOURCE_URL=jdbc:postgresql://localhost:55432/telecare
DATASOURCE_USERNAME=telecare
DATASOURCE_PASSWORD=telecare123
JPA_DDL_AUTO=update

# Redis Cache
REDIS_HOST=localhost
REDIS_PORT=56379
REDIS_PASSWORD=telecare123

# Apache Kafka Broker
KAFKA_BOOTSTRAP_SERVERS=localhost:59092

# Keycloak Identity & Access Management (IAM)
KEYCLOAK_SERVER_URL=http://localhost:59000
KEYCLOAK_ADMIN_USERNAME=telecare
KEYCLOAK_ADMIN_PASSWORD=telecare123
KEYCLOAK_ADMIN_REALM=master
KEYCLOAK_ADMIN_CLIENT_ID=admin-cli
KEYCLOAK_CURRENT_REALM=telecare-platform
KEYCLOAK_CLIENT_ID=telecare-id

# System Admin Bootstrap (Disable in production)
BOOTSTRAP_ADMIN_ENABLED=false
BOOTSTRAP_ADMIN_USERNAME=telecare
BOOTSTRAP_ADMIN_EMAIL=admin@telecare.vn
BOOTSTRAP_ADMIN_PASSWORD=Telecare@123
BOOTSTRAP_ADMIN_FIRST_NAME=System
BOOTSTRAP_ADMIN_LAST_NAME=Administrator

# AWS S3 Storage
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=telecare-files
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key

# Swagger Documentation (set false explicitly on production if not needed)
SWAGGER_ENABLED=true

# Shared runtime settings (no profile-specific application files).
SERVER_CONTEXT_PATH=/api/v1
SPRING_APPLICATION_NAME=telecare-backend
SPRING_DEVTOOLS_RESTART_ENABLED=false
SPRING_DEVTOOLS_ADD_PROPERTIES=false
SPRING_DEVTOOLS_LIVERELOAD_ENABLED=false
SPRING_OUTPUT_ANSI_ENABLED=ALWAYS
SPRING_MAIN_BANNER_MODE=off
SPRING_THREADS_VIRTUAL_ENABLED=true
DATASOURCE_DRIVER_CLASS_NAME=org.postgresql.Driver
JPA_SHOW_SQL=false
JPA_OPEN_IN_VIEW=false
JPA_DATABASE_DIALECT=org.hibernate.dialect.PostgreSQLDialect
JPA_FORMAT_SQL=false
HIKARI_MAXIMUM_POOL_SIZE=20
HIKARI_MINIMUM_IDLE=5
HIKARI_IDLE_TIMEOUT=300000
HIKARI_MAX_LIFETIME=1200000
HIKARI_CONNECTION_TIMEOUT=20000
HIKARI_POOL_NAME=TelecareProdHikariPool
JACKSON_DATE_FORMAT=yyyy-MM-dd HH:mm:ss
JACKSON_TIME_ZONE=Asia/Ho_Chi_Minh
KEYCLOAK_USER_EVENTS_TOPIC=keycloak-user-events
KAFKA_CONSUMER_GROUP_ID=user-service-group
KAFKA_AUTO_OFFSET_RESET=earliest
KAFKA_KEY_DESERIALIZER=org.apache.kafka.common.serialization.StringDeserializer
KAFKA_VALUE_DESERIALIZER=org.apache.kafka.common.serialization.StringDeserializer
MANAGEMENT_WEB_EXPOSURE_INCLUDE=health,info,prometheus
MANAGEMENT_INFO_ENV_ENABLED=false
MANAGEMENT_HEALTH_PROBES_ENABLED=true
MANAGEMENT_HEALTH_SHOW_DETAILS=never
MANAGEMENT_HEALTH_UP_STATUS=200
MANAGEMENT_HEALTH_DOWN_STATUS=503
MANAGEMENT_PROMETHEUS_ENABLED=true
MANAGEMENT_HTTP_HISTOGRAM_ENABLED=true
SERVER_COMPRESSION_ENABLED=true
SERVER_COMPRESSION_MIME_TYPES=text/html,text/xml,text/plain,text/css,text/javascript,application/javascript,application/json,application/xml
SERVER_COMPRESSION_MIN_RESPONSE_SIZE=2048
LOGGING_LEVEL_SECURITY=WARN
LOGGING_LEVEL_HIBERNATE=WARN
SWAGGER_API_DOCS_PATH=/v3/api-docs
SWAGGER_UI_PATH=/swagger-ui.html
SWAGGER_OPERATIONS_SORTER=alpha
SWAGGER_TAGS_SORTER=alpha
