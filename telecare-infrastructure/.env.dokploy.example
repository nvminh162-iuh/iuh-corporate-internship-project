# Private EC2 runtime settings. Copy into Dokploy > telecare-infrastructure > Environment.
# Credentials copied from the existing infrastructure .env; public endpoints configured for EC2.
# Do NOT upload your real credentials to Git or send them in screenshots.
POSTGRES_DB=keycloak
POSTGRES_USER=telecare
POSTGRES_PASSWORD=telecare123

# Redis and management tools (same services as the local Compose files).
REDIS_PASSWORD=telecare123
PGADMIN_DEFAULT_EMAIL=zolaracskh@gmail.com
PGADMIN_DEFAULT_PASSWORD=

KEYCLOAK_IMAGE=nvminh162/telecare-keycloak:latest
KEYCLOAK_ADMIN_USERNAME=telecare
KEYCLOAK_ADMIN_PASSWORD=
KEYCLOAK_HOSTNAME=https://telecare-auth.nvminh162.id.vn
KEYCLOAK_KAFKA_TOPIC=keycloak-user-events

# New, non-secret cluster identity for this staging Kafka instance.
# Keep this unchanged after the Kafka volume has been initialized.
KAFKA_CLUSTER_ID=V479II38SkWcGun0NbFKKg
