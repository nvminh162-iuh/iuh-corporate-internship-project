# ==============================================================================
# Telecare Staging Environment Configuration (.env.staging)
# Copy to .env on EC2 staging deployment directory
# NEVER commit the real .env file with production credentials to git.
# ==============================================================================

# 1. Image Registry and Immutable Tags
IMAGE_TAG=staging
BACKEND_IMAGE=your-aws-account-id.dkr.ecr.ap-southeast-1.amazonaws.com/telecare-backend
ADMIN_PORTAL_IMAGE=your-aws-account-id.dkr.ecr.ap-southeast-1.amazonaws.com/telecare-admin-portal
WEB_APP_IMAGE=your-aws-account-id.dkr.ecr.ap-southeast-1.amazonaws.com/telecare-web-app

# 2. Database (PostgreSQL)
DB_HOST=postgres
DB_PORT=5432
DB_NAME=telecare
DB_USERNAME=telecare
DB_PASSWORD=your-secure-staging-db-password

# 3. Redis Cache
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=your-secure-staging-redis-password

# 4. Kafka Broker
KAFKA_HOST=kafka
KAFKA_PORT=19092

# 5. Keycloak IAM
KEYCLOAK_INTERNAL_URL=http://keycloak:8080
KEYCLOAK_ADMIN_USERNAME=telecare
KEYCLOAK_ADMIN_PASSWORD=your-secure-staging-keycloak-admin-password

# 6. AWS S3 Storage
AWS_REGION=ap-southeast-1
AWS_S3_BUCKET=telecare-staging-files
# Prefer IAM Instance Profile on EC2 over static access keys:
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# 7. Port Bindings
BACKEND_PORT=55080
ADMIN_PORTAL_PORT=55000
WEB_APP_PORT=53000
